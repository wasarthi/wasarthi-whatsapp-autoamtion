# Caddy configuration for WA Sarthi
# Listens on port 80 (HTTP) for direct IP access without SSL redirect errors.
# To add automatic HTTPS for a custom domain, replace :80 with yourdomain.com.
:80 {
    # SSE (Server-Sent Events) stream for QR code / connection status.
    @sse path /api/qr-stream
    handle @sse {
        reverse_proxy app:3000 {
            flush_interval -1
        }
    }

    # All other requests
    reverse_proxy app:3000 {
        flush_interval 100ms
    }
}
