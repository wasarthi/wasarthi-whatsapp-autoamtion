# Caddy configuration for WA Sarthi
# Supports both HTTP (80) and HTTPS (443 with self-signed for direct IP access)
:80 {
    @sse path /api/qr-stream
    handle @sse {
        reverse_proxy app:3000 {
            flush_interval -1
        }
    }
    reverse_proxy app:3000 {
        flush_interval 100ms
    }
}

:443 {
    tls internal
    @sse path /api/qr-stream
    handle @sse {
        reverse_proxy app:3000 {
            flush_interval -1
        }
    }
    reverse_proxy app:3000 {
        flush_interval 100ms
    }
}
