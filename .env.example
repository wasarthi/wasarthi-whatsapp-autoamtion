# ─── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Session secret ───────────────────────────────────────────
# Used to sign login session cookies. Set a 64+ char random string for production.
# If left unset, one is generated automatically on first run and saved to data/.session_secret.
SESSION_SECRET=

# ─── Gemini AI API Key ────────────────────────────────────────
# Get a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Demo Mode ───────────────────────────────────────────────
# Set to "true" to run the dashboard with mock data (no WhatsApp required).
# Set to "false" (default) for production WhatsApp automation.
DEMO_MODE=false

# ─── Allowed cross-origin origins (optional) ───────────────────
# Comma-separated list of allowed origins (e.g. https://app.example.com)
ALLOWED_ORIGINS=

# ─── Reverse Proxy & TLS ──────────────────────────────────────
# Set to "true" when behind Caddy/nginx/Cloudflare
TRUST_PROXY=false
FORCE_HTTPS=false

# ─── Concurrency & Capacity Controls ─────────────────────────
# Max simultaneous WhatsApp Puppeteer/Chrome instances (each ~150-250MB RAM)
# Sizing guide: (total_RAM_GB - 1) × 3. E.g. 2GB VPS → 3, 4GB VPS → 9
MAX_CONCURRENT_WHATSAPP_SESSIONS=5

# Max concurrent AI/Gemini requests in-flight (globally across all users and per-user)
MAX_CONCURRENT_AI_JOBS=8
MAX_CONCURRENT_AI_PER_USER=2
GEMINI_TIMEOUT_MS=30000

# Max concurrent bulk outreach campaigns across platform and per user
MAX_CONCURRENT_OUTREACH_JOBS=5
MAX_CONCURRENT_OUTREACH_PER_USER=1
MAX_OUTREACH_RECIPIENTS_PER_JOB=25

# Max SSE event streams (live status & QR code streaming)
MAX_SSE_CLIENTS_PER_USER=5
MAX_SSE_CLIENTS_TOTAL=250

# Restart & Shutdown Timing
RESUME_STAGGER_MS=4000
SHUTDOWN_GRACE_MS=15000

# ─── Google Calendar integration (optional) ─────────────────────
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/oauth/callback
