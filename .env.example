# WhatsApp Cloud API Credentials
# Get these from: https://developers.facebook.com > Your App > WhatsApp > API Setup

WHATSAPP_TOKEN=your_permanent_system_user_token_here
WHATSAPP_PHONE_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ID=your_business_account_id_here

# Webhook verification token (choose any random string)
WEBHOOK_VERIFY_TOKEN=my_secret_verify_token_123

# Server port
PORT=3000

# Demo mode (set to "true" to use the dashboard without real API credentials)
DEMO_MODE=true

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here
