# ─── Server ───────────────────────────────────────────────────
PORT=3000

# ─── Session secret (optional) ─────────────────────────────────
# Used to sign login session cookies. If left unset, one is generated
# automatically on first run and saved to data/.session_secret — every
# account would need to log in again if that file is ever deleted.
# Set this yourself for production deployments.
SESSION_SECRET=

# ─── Gemini AI API Key ────────────────────────────────────────
# Get a FREE key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Demo Mode ───────────────────────────────────────────────
# Set to "true" to run the dashboard with fake data (no WhatsApp needed)
# Set to "false" (default) to run the real bot
DEMO_MODE=false

# ─── Allowed cross-origin origins (optional) ───────────────────
# This app serves its own frontend, so this is normally left blank — the
# dashboard talks to the API on the same origin and never needs it. Only set
# this (comma-separated, e.g. https://app.example.com,https://foo.example.com)
# if some OTHER site needs to make authenticated (cookie-carrying) requests
# to this API. Leaving it blank blocks that kind of cross-site access, which
# is the safer default.
ALLOWED_ORIGINS=

# ─── Concurrent WhatsApp session cap (optional) ─────────────────
# Each connected account spins up its own headless Chrome process. This caps
# how many can run at once so a burst of new signups can't exhaust server
# memory/CPU. Raise it if you're on a bigger box; defaults to 25.
MAX_CONCURRENT_WHATSAPP_SESSIONS=25

# ─── Trust proxy (only if deployed behind Caddy/nginx/Cloudflare) ──
# Leave "false" when running directly (local demo, bare `npm start`, a tunnel
# like ngrok/cloudflared). Set to "true" ONLY once a reverse proxy you control
# sits in front of this process (see docker-compose.yml + Caddyfile) — it's
# what makes the login/signup rate limiters see each visitor's real IP
# instead of treating everyone behind the proxy as one IP.
TRUST_PROXY=false
