# Dependencies
node_modules/

# Environment Variables & Secrets
.env
.env.local
.env.*.local

# opencode config contains a live API key — never commit it
opencode.json

# Tooling binaries that shouldn't be in the repo
*.exe

# WhatsApp Web Session & Auth Data (CRITICAL: Do not commit tokens)
.wwebjs_auth/
.wwebjs_cache/

# SQLite Database & Local Data + the auto-generated session-signing secret
# (data/.session_secret signs every login cookie — if it ever leaked into a
# commit, anyone with it could forge a valid session for ANY account,
# including admin. Ignore the whole data/ folder, not just *.db, so nothing
# added under it in the future gets missed the way this one nearly was.)
data/
*.sqlite
*.db

# Test isolation directories (per-test PERSIST_ROOT)
test-data/

# Coverage output
coverage/

# Build / deploy artifacts
deploy.zip
*.err

# Logs & Debugging
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/

# IDE/Editor temp files
*.swp
*.swo
*~